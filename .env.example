# ------------------------------------------------------------------
# Church ERP / CMS — environment configuration template
# Copy this file to `.env` and adjust values. `.env` is gitignored.
# ------------------------------------------------------------------

# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Database
# Leave DATABASE_URL unset to use the default SQLite file (cms.db in the
# project root). To migrate to Postgres, just uncomment and set this line:
#   DATABASE_URL=postgresql://user:password@localhost:5432/cms
# DATABASE_URL=

# Where mutable app data lives (uploads, backups). Relative to project root
# by default; in Docker this is a mounted volume.
APP_DATA_DIR=.

# ------------------------------------------------------------------
# Storage backend: "local" (default, free) or "minio" (free, self-hosted)
# ------------------------------------------------------------------
STORAGE_BACKEND=local

# MinIO / S3-compatible (only used when STORAGE_BACKEND=minio)
# Also works with Backblaze B2 / Cloudflare R2 free tiers.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cms
MINIO_REGION=us-east-1

# ------------------------------------------------------------------
# Security
# ------------------------------------------------------------------
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# ------------------------------------------------------------------
# Email (SMTP)
# ------------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=church@example.com

# ------------------------------------------------------------------
# Twilio (SMS + WhatsApp)
# Set SMS_PROVIDER=log to disable real sends (e.g. in tests).
# ------------------------------------------------------------------
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ------------------------------------------------------------------
# Google Forms / Sheets import (service account JSON path)
# ------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=
