{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{tests/**,.venv/**,.git/**,__pycache__/**,backups/**,uploads/**,docs/**,.pytest_cache/**,tmp/**,prompts/**,plan/**,.claude/**}"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
